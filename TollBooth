import java.util.*;
public class TollBooth {
    record Vehicle(String number, String type) {}
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int total = 0, bikes = 0, cars = 0, trucks = 0;
        while (true) {
            System.out.print("Vehicle number (done to finish): ");
            String number = sc.next();
            if (number.equalsIgnoreCase("done")) break;
            System.out.print("Type (bike/car/truck): ");
            String type = sc.next().toLowerCase();
            Vehicle v = new Vehicle(number, type);
            int toll = switch (v.type()) {
                case "bike" -> 20; case "car" -> 50; case "truck" -> 150;
                default -> throw new IllegalArgumentException("Unknown vehicle type");
            };
            total += toll;
            switch (v.type()) {
                case "bike" -> bikes++; case "car" -> cars++; case "truck" -> trucks++;            }
        }
        String most = bikes >= cars && bikes >= trucks ? "bike" :
                      cars >= trucks ? "car" : "truck";
        System.out.println("Total toll: " + total);
        System.out.println("Most frequent: " + most);
        sc.close();
    }
}
