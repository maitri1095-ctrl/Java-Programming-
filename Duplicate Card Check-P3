import java.util.*;

class Card {
    private String rank;
    private String suit;

    Card(String rank, String suit) {
        this.rank = rank;
        this.suit = suit;
    }

    @Override
    public String toString() {
        return rank + " of " + suit;
    }

    @Override
    public boolean equals(Object o) {
        if (!(o instanceof Card c))
            return false;

        return rank.equals(c.rank) && suit.equals(c.suit);
    }

    @Override
    public int hashCode() {
        return Objects.hash(rank, suit);
    }
}

public class Driver {
    public static void main(String[] args) {
        Card[] cards = {
            new Card("Ace", "Spades"),
            new Card("Queen", "Hearts"),
            new Card("Ace", "Spades"),
            new Card("King", "Clubs")
        };

        List<Card> seen = new ArrayList<>();

        for (Card c : cards) {
            if (seen.contains(c)) {
                System.out.println("Duplicate found: " + c);
                break;
            }

            seen.add(c);
        }
    }
}
